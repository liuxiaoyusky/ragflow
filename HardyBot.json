      "parameters": {
        "jsCode": "// 获取输入的 JSON 数据\nconst inputData = $('AskRAG').first().json.data.reference;\n\n// 获取 chunks 数组（在第一个对象的 chunks 属性中）\nconst chunks = inputData.chunks;\n\n// 提取每个 chunk 的 4 个字段\nconst results = chunks.map((chunk, index) => {\n  return {\n    json: {\n      index: index,\n      document_id: chunk.document_id,\n      dataset_id: chunk.dataset_id,\n      document_name: chunk.document_name,\n      image_id: chunk.image_id\n    }\n  };\n});\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        192
      ],
      "id": "d12e8ddc-493a-4251-9717-30b692e1e21b",
      "name": "ArrayHandling"
    },
    {
      "parameters": {
        "jsCode": "// 确保只处理第一个 item，或收集所有输入后合并\nconst allItems = $input.all();\nconst firstItem = allItems[0].json;\nconst chunk = firstItem.chunk ?? firstItem; // 兼容不同输入结构\n\n// 从第一个 item 或所有 items 中提取 image_key\n// const imageKeys = firstItem.image_key ?? \n//   allItems.find(item => item.json.image_key)?.json.image_key ?? [];\n\nconst base = 'http://10.1.9.133:8080/chunk/parsed/chunks';\n\nlet mdLines = ['References'];\nlet elements = [];\n\nfor (let i = 0; i < chunk.document_id.length; i++) {\n  const name = chunk.document_name[i];\n  const docId = chunk.document_id[i];\n  const url = `${base}?id=${chunk.dataset_id[i]}&doc_id=${docId}`;\n  // const imgKey = imageKeys[i];\n\n  mdLines.push(`- [${name}](${url})`);\n//   mdLines.push(`![${name}](feishu://image/${imgKey})`);\n\n  // 修复：图片必须是独立的 img 元素，不能放在 extra 里\n  elements.push({\n    tag: 'div',\n    text: { tag: 'lark_md', content: `[${name}](${url})` },\n  });\n  // elements.push({\n  //   tag: 'img',\n  //   img_key: imgKey,\n  //   alt: { tag: 'plain_text', content: name },\n  // });\n}\n\nconst markdown = mdLines.join('\\n');\nconst card = {\n  config: { wide_screen_mode: true, enable_forward: false },\n  header: {\n    title: { tag: 'plain_text', content: 'Chunk References' },\n    template: 'blue',\n  },\n  elements,\n};\n\n// 关键：只返回一个 item，确保 card 只推送一次\nreturn [{ json: { markdown, card } }];"
      },
