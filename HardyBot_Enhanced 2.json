    {
      "parameters": {
        "jsCode": "// 确保只处理第一个 item，或收集所有输入后合并\nconst allItems = $input.all();\nconst firstItem = allItems[0].json;\nconst chunk = firstItem.chunk ?? firstItem; // 兼容不同输入结构\n\nconst base = 'http://10.1.9.133:8080/chunk/parsed/chunks';\n\nlet mdLines = ['References'];\nlet elements = [];\n\nfor (let i = 0; i < chunk.document_id.length; i++) {\n  const name = chunk.document_name[i];\n  const docId = chunk.document_id[i];\n  const url = `${base}?id=${chunk.dataset_id[i]}&doc_id=${docId}`;\n\n  mdLines.push(`- [${name}](${url})`);\n\n  elements.push({\n    tag: 'div',\n    text: { tag: 'lark_md', content: `[${name}](${url})` },\n  });\n}\n\nconst markdown = mdLines.join('\\n');\nconst card = {\n  config: { wide_screen_mode: true, enable_forward: false },\n  header: {\n    title: { tag: 'plain_text', content: 'Chunk References' },\n    template: 'blue',\n  },\n  elements,\n};\n\nreturn [{ json: { markdown, card } }];"
      },
