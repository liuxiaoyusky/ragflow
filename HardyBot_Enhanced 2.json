    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 解析OpenRouter返回的结果\n// 从EscapedCharacters1获取原始问题\nconst originalQuestion = $('EscapedCharacters1').item.json.escaped_text;\n\n// 获取LLM返回的增强问题\nlet enhancedQuestion = '';\ntry {\n  enhancedQuestion = $json.choices?.[0]?.message?.content || '';\n  enhancedQuestion = enhancedQuestion.trim();\n} catch (e) {\n  console.log('解析LLM返回失败:', e.message);\n  enhancedQuestion = originalQuestion; // 失败时使用原问题\n}\n\n// 如果LLM返回为空，使用原问题\nif (!enhancedQuestion) {\n  enhancedQuestion = originalQuestion;\n}\n\n// JSON安全转义\nconst jsonEscape = (str) => {\n  return str\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\n/g, ' ')\n    .replace(/\\r/g, '')\n    .replace(/\\t/g, ' ');\n};\n\nconst escapedEnhanced = jsonEscape(enhancedQuestion);\n\nconsole.log('原问题:', originalQuestion);\nconsole.log('增强后:', enhancedQuestion);\nconsole.log('是否增强:', originalQuestion !== enhancedQuestion);\n\nreturn {\n  json: {\n    original_question: originalQuestion,\n    enhanced_question: enhancedQuestion,\n    escaped_enhanced_question: escapedEnhanced,\n    was_enhanced: originalQuestion !== enhancedQuestion\n  }\n};"
      },
