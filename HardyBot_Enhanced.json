    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 获取原始文本\nconst originalText = $('AskRAG').item.json.data.answer;\nconst mdText = $json.markdown;\n\n// JSON安全转义函数\nconst jsonEscape = (str) => {\n  return str\n    .replace(/\\\\/g, '\\\\\\\\')    // 反斜杠\n    .replace(/\"/g, '\\\\\"')      // 双引号\n    .replace(/\\n/g, '\\\\n')     // 换行符\n    .replace(/\\r/g, '\\\\r')     // 回车符\n    .replace(/\\t/g, '\\\\t')     // 制表符\n    .replace(/\\f/g, '\\\\f')     // 换页符\n    .replace(/\\v/g, '\\\\v');    // 垂直制表符\n};\n\nconst escapedText = jsonEscape(originalText);\nconst escapedMdText = jsonEscape(mdText);\n\nreturn {\n  json: {\n    original_text: originalText,\n    escaped_text: escapedText,\n    escapedMdText: escapedMdText\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
