      "parameters": {
        "jsCode": "// 解析JSON字符串，兼容Webhook和Lark Trigger两种输入\nlet questionContent = $json.question;\n\n// 如果question为null或undefined，尝试从PrimaryParam获取\nif (!questionContent) {\n  try {\n    questionContent = $('PrimaryParam').item.json.question;\n  } catch (e) {\n    // 如果还是获取不到，尝试从Webhook的body获取\n    questionContent = $json.body?.message?.content || $json.message?.content;\n  }\n}\n\n// 如果questionContent是字符串，尝试解析JSON\nlet questionData;\nif (typeof questionContent === 'string') {\n  try {\n    questionData = JSON.parse(questionContent);\n  } catch (e) {\n    // 如果不是JSON格式，直接使用字符串\n    questionData = { text: questionContent };\n  }\n} else if (questionContent && typeof questionContent === 'object') {\n  // 如果已经是对象，直接使用\n  questionData = questionContent;\n} else {\n  // 默认值\n  questionData = { text: '' };\n}\n\n// 提取text内容\nreturn {\n  json: {\n    original_question: questionContent,\n    extracted_text: questionData.text || questionData.content || ''\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -896,
