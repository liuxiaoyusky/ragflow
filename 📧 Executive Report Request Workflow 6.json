        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 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"
            },
            {
              "name": "HTTP-Referer",
              "value": "https://n8n.vp.com.hk"
            },
            {
              "name": "X-Title",
              "value": "Executive Report Workflow"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.prompt) }}\n    }\n  ],\n  \"temperature\": 0.3,\n  \"max_tokens\": 2000\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "f788a806-bcf0-44f6-9d42-ab348ab7e42d",
      "name": "调用OpenRouter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// 步骤3: 解析OpenRouter返回的结果\nconst items = $input.all();\nconst results = [];\n\nconsole.log('📦 收到OpenRouter响应数量:', items.length);\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const preparedData = $('准备数据').all()[i]?.json || {};\n  \n  console.log('\\n--- 解析响应 #' + (i + 1) + ' ---');\n  console.log('📋 原始响应:', JSON.stringify(item.json).substring(0, 500));\n  \n  // 获取AI返回的内容\n  const content = item.json.choices?.[0]?.message?.content || '';\n  console.log('📝 AI返回内容:', content);\n  \n  if (!content) {\n    console.log('⚠️ AI返回内容为空');\n    continue;\n  }\n  \n  // 解析JSON\n  let companies = [];\n  try {\n    companies = JSON.parse(content);\n    console.log('✅ JSON直接解析成功');\n  } catch (e) {\n    console.log('⚠️ JSON直接解析失败，尝试提取...');\n    // 尝试从内容中提取JSON数组\n    const jsonMatch = content.match(/\\[.*\\]/s);\n    if (jsonMatch) {\n      try {\n        companies = JSON.parse(jsonMatch[0]);\n        console.log('✅ 从内容中提取JSON成功');\n      } catch (e2) {\n        console.log('❌ 提取JSON也失败:', e2.message);\n      }\n    }\n  }\n  \n  console.log('📊 提取到公司数量:', companies.length);\n  companies.forEach((c, idx) => {\n    console.log(`  ${idx + 1}. ${c.ticker} - ${c.companyName}`);\n  });\n  \n  if (companies.length === 0) {\n    console.log('⚠️ 未提取到公司信息');\n    continue;\n  }\n  \n  results.push({\n    json: {\n      emailId: preparedData.emailId,\n      replyTo: preparedData.from,\n      originalSubject: preparedData.subject,\n      companies: companies,\n      extractedAt: new Date().toISOString()\n    }\n  });\n}\n\nconsole.log('\\n📊 解析完成，输出', results.length, '条结果');\nreturn results;"
      },
