      "id": "3b61228b-74b8-416a-a8a4-98e7984bf2ff",
      "name": "监听skyliu邮箱",
      "webhookId": "35b3c09c-bbd3-4d15-a7fd-139038e491fb",
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "tBuNrq8u1VIkXLZH",
          "name": "Microsoft Outlook account 5"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 步骤1: 准备数据 - 提取邮件内容，构建OpenRouter请求\nconst items = $input.all();\nconst results = [];\n\nconsole.log('📧 收到邮件数量:', items.length);\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  \n  console.log('\\n--- 处理邮件 #' + (i + 1) + ' ---');\n  console.log('📋 邮件ID:', item.json.id);\n  console.log('📋 主题:', item.json.subject);\n  \n  // 提取邮件内容\n  const emailId = item.json.id;\n  const subject = item.json.subject || '';\n  const body = item.json.body?.content || item.json.bodyPreview || '';\n  \n  // 处理from字段（可能是字符串或对象）\n  let from = '';\n  if (typeof item.json.from === 'string') {\n    from = item.json.from;\n  } else if (item.json.from?.emailAddress?.address) {\n    from = item.json.from.emailAddress.address;\n  }\n  \n  console.log('📤 发件人:', from);\n  console.log('📄 Body长度:', body.length);\n  console.log('📄 Body预览:', body.substring(0, 200));\n  \n  if (!body) {\n    console.log('⚠️ 邮件内容为空，跳过');\n    continue;\n  }\n  \n  // 构建prompt\n  const prompt = `你是一个专业的金融数据提取助手。请从以下邮件内容中提取所有提到的公司和股票信息。\n\n返回格式必须是JSON数组，每个元素包含：\n- ticker: 股票代码（格式: \"代码 交易所\"，如 \"AAPL US\"、\"0700 HK\"、\"BABA US\"）\n- companyName: 公司名称\n\n如果无法确定交易所，请根据公司类型推测（美股用US，港股用HK，A股用CH）。\n如果完全无法提取到公司信息，返回空数组 []。\n\n只返回JSON，不要其他文字。\n\n邮件主题: ${subject}\n\n邮件正文:\n${body}`;\n  \n  console.log('✅ Prompt构建完成，长度:', prompt.length);\n  \n  results.push({\n    json: {\n      emailId: emailId,\n      subject: subject,\n      body: body,\n      from: from,\n      prompt: prompt\n    }\n  });\n}\n\nconsole.log('\\n📊 准备完成，输出', results.length, '条数据');\nreturn results;"
      },
      "id": "ebac52af-7222-4743-8622-a49cba2c2d70",
      "name": "准备数据",
